{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}
}

(security_headers) {
	header {
		Content-Security-Policy "frame-ancestors 'self' https://teams.microsoft.com https://*.teams.microsoft.com https://*.microsoft.com https://*.cloud.microsoft https://*.office.com https://*.microsoft365.com https://*.skype.com https://*.teams.microsoft.us https://local.teams.office.com https://*.mcas.ms"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	import security_headers

	@hashed {
		path_regexp -[A-Z0-9]{8}\.[a-z0-9]+$
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=0, must-revalidate"

	@asset path *.js *.css *.map *.json *.ico *.png *.jpg *.jpeg *.gif *.svg *.webp *.avif *.woff *.woff2 *.ttf *.eot *.otf *.txt *.xml *.webmanifest *.wasm

	handle /health {
		respond "ok" 200
	}

	handle @asset {
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
